// GPS configs not provided by AOSPA's hardware/qcom/gps (which already installs
// gps.conf, flp.conf, gnss_antenna_info.conf and the gnss seccomp policies).
// Only the device-specific extras remain here to avoid duplicate ETC modules.

prebuilt_etc {
    name: "izat.conf",
    vendor: true,
    src: "izat.conf",
}

prebuilt_etc {
    name: "lowi.conf",
    vendor: true,
    src: "lowi.conf",
}

prebuilt_etc {
    name: "sap.conf",
    vendor: true,
    src: "sap.conf",
}

prebuilt_etc {
    name: "xtwifi.conf",
    vendor: true,
    src: "xtwifi.conf",
}
